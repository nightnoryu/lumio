package portfolio

import "lumio/internal/domain"

templ Page(d domain.Draft, images map[string]string) {
 <!DOCTYPE html>
 <html lang="en">
 <head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content="noindex, nofollow"/>
  <title>{ d.DisplayName } — Photography</title>
  <style>html{color-scheme:light}*{box-sizing:border-box}body{margin:0;background:#faf9f6;color:#242521;font:17px/1.65 Georgia,serif}body.dark{background:#191b1a;color:#f5f3ed;color-scheme:dark}body.warm{background:#eee5d8;color:#40392f}body.sans{font-family:Arial,sans-serif}main{max-width:1280px;margin:auto;padding:48px 5vw}h1{font-size:clamp(2.6rem,7vw,6rem);line-height:1.06;letter-spacing:-.04em;font-weight:400;margin:20px 0}h2{font-size:2rem;font-weight:400}a{color:inherit;text-underline-offset:5px}p{white-space:pre-line}.intro{max-width:760px;margin:0 auto 64px;text-align:center}.profile{width:140px;height:auto}.cover{display:block;max-height:75vh;width:100%;object-fit:contain;margin-bottom:64px}.gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px;align-items:start}.gallery.column{grid-template-columns:1fr;max-width:900px;margin:auto}figure{margin:0}figure img{display:block;width:100%;height:auto}figcaption{font:14px/1.5 Arial,sans-serif;margin-top:8px;opacity:.75}.editorial .intro{text-align:left;margin-left:0;max-width:900px}.editorial .gallery:not(.column) figure:nth-child(3n+1){grid-column:1/-1}.services{margin:80px 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:32px}.services h2{grid-column:1/-1}article{border-top:1px solid;padding-top:16px}footer{padding:32px 0;border-top:1px solid;display:flex;gap:24px;flex-wrap:wrap}@media(max-width:640px){main{padding:32px 6vw}.gallery{grid-template-columns:1fr;gap:24px}.intro{margin-bottom:32px}.cover{margin-bottom:32px}.services{margin:48px 0}}</style>
 </head>
 <body class={ d.Colour + " " + d.Typography + " " + d.Template }>
 <main>
  if d.Template == "editorial" {
   @Cover(d.CoverPhoto, images)
   @Profile(d, images)
  } else {
   @Profile(d, images)
   @Cover(d.CoverPhoto, images)
  }
  @Gallery(d, images)
  @Services(d)
  <footer aria-label="Contact">
   for _, c := range d.Contacts {
    <a href={ templ.SafeURL(c.URL) } rel="noopener noreferrer">{ c.Label }</a>
   }
  </footer>
 </main>
 </body>
 </html>
}
templ Profile(d domain.Draft, images map[string]string) {
 <header class="intro">
  if d.ProfilePhoto != "" {
   <img class="profile" src={ images[d.ProfilePhoto] } alt={ d.DisplayName }/>
  }
  <p>{ d.Specialization }</p>
  <h1>{ d.DisplayName }</h1>
  <p>{ d.Location }</p>
  <p>{ d.Biography }</p>
 </header>
}
templ Cover(id string, images map[string]string) {
 if id != "" {
  <img class="cover" src={ images[id] } alt="" fetchpriority="high"/>
 }
}
templ Gallery(d domain.Draft, images map[string]string) {
 <section class={ "gallery " + d.Layout } aria-label="Portfolio photographs">
  for _, p := range d.Photos {
   <figure>
    <img src={ images[p.ID] } alt={ p.Alt } loading="lazy"/>
    if p.Category != "" {
     <figcaption>{ p.Category }</figcaption>
    }
   </figure>
  }
 </section>
}
templ Services(d domain.Draft) {
 if len(d.Services) > 0 {
  <section class="services" aria-label="Services and pricing">
   <h2>Services</h2>
   for _, s := range d.Services {
    <article>
     <h3>{ s.Name }</h3>
     <p>{ s.Description }</p>
     if !d.HidePrices && s.Price != "" {
      <p>{ s.Price }</p>
     }
    </article>
   }
  </section>
 }
}
