package portfolio

import "lumio/internal/domain"

templ Page(d domain.Draft, images map[string]string, options ...Metadata) {
 {{ meta := pageMetadata(d, images, options) }}
 <!DOCTYPE html>
 <html lang={ pageLanguage(d) }>
 <head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  if meta.Canonical == "" {
   <meta name="robots" content="noindex, nofollow"/>
  } else {
   <link rel="canonical" href={ meta.Canonical }/>
   <meta property="og:url" content={ meta.Canonical }/>
  }
  <title>{ meta.Title }</title>
  <meta name="description" content={ meta.Description }/>
  <meta property="og:type" content="website"/>
  <meta property="og:title" content={ meta.Title }/>
  <meta property="og:description" content={ meta.Description }/>
  if meta.Image != "" {
   <meta property="og:image" content={ meta.Image }/>
   <meta property="og:image:alt" content={ meta.ImageAlt }/>
  }
  <script src="/portfolio.js" defer></script>
  @templ.Raw("<style>" + portfolioCSS + "</style>")
 </head>
 <body class={ d.Colour + " " + d.Typography + " " + d.Template }>
 <a class="skip" href="#main">{ localize(d, "Skip to content") }</a>
 <div class="shell" id="top">
 <header class="site-header">
  <a class="brand" href="#top">{ d.DisplayName }<span aria-hidden="true"> ✳</span></a>
  <nav aria-label={ localize(d, "Main navigation") }>
   if len(d.Photos) > 0 {
    <a href="#photographs">{ localize(d, "Work") }</a>
   }
   if d.Biography != "" || d.ProfilePhoto != "" {
    <a href="#about">{ localize(d, "About") }</a>
   }
   if len(d.Contacts) > 0 {
    <a href="#contact">{ localize(d, "Contact") } ↗</a>
   }
  </nav>
 </header>
 <main id="main">
  <div class="hero">
   @Profile(d)
   @Cover(d.CoverPhoto, images, meta.Sources)
  </div>
  if len(d.Photos) > 0 {
   <div class="section-heading"><span class="eyebrow">01 / { localize(d, "Portfolio") }</span><h2>{ localize(d, "Selected work") }</h2></div>
   @Gallery(d, images, meta.Sources)
  }
  if d.Biography != "" || d.ProfilePhoto != "" {
   <section class="about" id="about" aria-label={ localize(d, "About") }>
    <div><span class="eyebrow">{ localize(d, "Behind the lens") }</span>
     if d.ProfilePhoto != "" {
      <img class="profile" src={ images[d.ProfilePhoto] } srcset={ meta.Sources[d.ProfilePhoto] } sizes="240px" alt={ d.DisplayName } loading="lazy"/>
     }
    </div>
    <div><h2>{ d.DisplayName }</h2><p class="biography">{ d.Biography }</p>
     if d.Location != "" {
      <p class="eyebrow">{ d.Location }</p>
     }
    </div>
   </section>
  }
  @Services(d)
  if len(d.Contacts) > 0 {
   <section class="contact" id="contact" aria-label={ localize(d, "Contact") }>
    <span class="eyebrow">{ localize(d, "Have a project in mind?") }</span>
    <h2>{ localize(d, "Let’s make something memorable.") }</h2>
    <div class="contact-links">
     for _, c := range d.Contacts {
      <a href={ templ.SafeURL(c.URL) } rel="noopener noreferrer">{ c.Label } <span aria-hidden="true">↗</span></a>
     }
    </div>
   </section>
  }
 </main>
 <footer><span>{ d.DisplayName } · { localize(d, "Photography") }</span><a href="#top">{ localize(d, "Back to top") } ↑</a></footer>
 </div>
 <dialog id="photo-viewer" aria-label={ localize(d, "Full-screen photograph") }>
  <div class="viewer-controls"><button type="button" data-close>{ localize(d, "Close") }</button><button type="button" data-previous aria-label={ localize(d, "Previous photograph") }>{ localize(d, "Previous") }</button><p aria-live="polite" data-position></p><button type="button" data-next aria-label={ localize(d, "Next photograph") }>{ localize(d, "Next") }</button></div>
  <img data-viewer-image alt=""/>
  <p data-caption></p>
 </dialog>
 </body>
 </html>
}
templ Profile(d domain.Draft) {
 <header class="intro">
  <p class="eyebrow">{ d.Specialization }</p>
  <h1>{ d.DisplayName }</h1>
  <div class="hero-bottom">
   <p class="location">{ d.Location }</p>
   if len(d.Photos) > 0 {
    <a class="work-link" href="#photographs">{ localize(d, "Explore selected work") } <span aria-hidden="true">↓</span></a>
   }
  </div>
 </header>
}
templ Cover(id string, images map[string]string, sources map[string]string) {
 if id != "" {
  <img class="cover" src={ images[id] } srcset={ sources[id] } sizes="(max-width: 640px) 88vw, (max-width: 1600px) 90vw, 1440px" alt="" fetchpriority="high"/>
 }
}
templ Gallery(d domain.Draft, images map[string]string, sources map[string]string) {
 <section id="photographs" class={ "gallery " + d.Layout } aria-label={ localize(d, "Portfolio photographs") }>
  for index, p := range d.Photos {
   <figure>
    <a href={ templ.SafeURL(images[p.ID]) } data-photo aria-label={ localize(d, "View photograph: ") + p.Alt }>
     <img src={ images[p.ID] } srcset={ sources[p.ID] } sizes={ gallerySizes(d, index) } alt={ p.Alt } loading={ imageLoading(d, index) } decoding="async"/>
    </a>
    if p.Category != "" {
     <figcaption>{ p.Category }</figcaption>
    }
   </figure>
  }
 </section>
}
templ Services(d domain.Draft) {
 if len(d.Services) > 0 {
  <section id="services" class="services" aria-label={ localize(d, "Services and pricing") }>
   <h2>{ localize(d, "Services") }</h2>
   for _, s := range d.Services {
    <article>
     <h3>{ s.Name }</h3>
     <p>{ s.Description }</p>
     if !d.HidePrices && s.Price != "" {
      <p class="price">{ s.Price }</p>
     }
    </article>
   }
  </section>
 }
}
